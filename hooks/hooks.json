{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/recall.py\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Searching long-term memory..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/checkpoint.py\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
